<!--
  profile 个人主页 — 像素级对齐原型 profile.html
  原型路径: c-end/pages/profile.html
-->
<view class="container">

  <!-- 导航栏 -->
  <view class="nav-wrap" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar"></view>
  </view>

  <view class="page-content">

    <!-- 加载状态 -->
    <view class="global-loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 个人资料卡片 -->
    <view class="profile-card" wx:if="{{!loading}}">
      <view class="avatar">👤</view>
      <view class="info">
        <view class="name-row">
          <view class="name">{{roomInfo}}</view>
          <view class="logout-icon" bindtap="onLogoutTap">
            <image class="logout-icon-img" src="../../images/logout-icon.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="meta">
          <view class="auth-tag {{isAuth ? 'authed' : 'unauthed'}}">{{isAuth ? '已认证' : '未认证'}}</view>
          <text>{{userTypeText}}</text>
        </view>
        <view class="rate">综合评分 {{score}} / 5.0 · {{ratingCount}} 人评价</view>
      </view>
    </view>

    <!-- 统计网格 -->
    <view class="profile-stats-grid" wx:if="{{!loading}}">
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{borrowCount}}</text>
        <text class="profile-stat-label">借入次数</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{borrowReturnRate}}%</text>
        <text class="profile-stat-label">按时归还率</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{lendCount}}</text>
        <text class="profile-stat-label">借出次数</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{helpReqCount}}</text>
        <text class="profile-stat-label">求助次数</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{helpProCount}}</text>
        <text class="profile-stat-label">帮助他人</text>
      </view>
    </view>

    <!-- 记录标签 -->
    <view class="record-header">
      <view class="segment">
        <view class="segment-item {{recordTab === CONTENT_TYPE.IDLE ? 'active' : ''}}" bindtap="onRecordTabTap" data-tab="{{CONTENT_TYPE.IDLE}}">互借记录</view>
        <view class="segment-item {{recordTab === CONTENT_TYPE.HELP ? 'active' : ''}}" bindtap="onRecordTabTap" data-tab="{{CONTENT_TYPE.HELP}}">互助记录</view>
      </view>
    </view>

    <!-- 互借记录 -->
    <view class="record-list" wx:if="{{recordTab === CONTENT_TYPE.IDLE}}">
      <block wx:for="{{idleRecords}}" wx:key="id">
        <view class="list-row" bindtap="onOpenRecord" data-record="{{item}}">
          <view class="list-bd">
            <view class="list-title">{{item.title}}</view>
            <view class="list-desc">{{item.roleText}}：{{item.peerName}} · {{item.dateText}}</view>
          </view>
          <view class="list-ft">
            <view class="record-tag {{item.type === 'LEND' ? 'lend' : 'borrow'}}">{{item.typeText}}</view>
          </view>
        </view>
      </block>
      <view class="empty-state" wx:if="{{idleRecords.length === 0}}">
        <text class="empty-text">暂无互借记录</text>
      </view>
      <view class="list-end" wx:if="{{idleRecords.length > 0}}">— 共 {{idleRecords.length}} 条记录 —</view>
    </view>

    <!-- 互助记录 -->
    <view class="record-list" wx:if="{{recordTab === CONTENT_TYPE.HELP}}">
      <block wx:for="{{helpRecords}}" wx:key="id">
        <view class="list-row" bindtap="onOpenRecord" data-record="{{item}}">
          <view class="list-bd">
            <view class="list-title">{{item.title}}</view>
            <view class="list-desc">{{item.roleText}}：{{item.peerName}} · {{item.dateText}}</view>
          </view>
          <view class="list-ft">
            <view class="record-tag {{item.type === 'HELP' ? 'help' : 'seek'}}">{{item.typeText}}</view>
          </view>
        </view>
      </block>
      <view class="empty-state" wx:if="{{helpRecords.length === 0}}">
        <text class="empty-text">暂无互助记录</text>
      </view>
      <view class="list-end" wx:if="{{helpRecords.length > 0}}">— 共 {{helpRecords.length}} 条记录 —</view>
    </view>

  </view>

</view>

<!-- 退出登录确认弹窗 -->
<view class="alert-overlay" wx:if="{{showLogoutAlert}}" catchtap="onCloseLogoutAlert">
  <view class="alert" catchtap="">
    <view class="alert-title">退出登录</view>
    <view class="alert-body">确定要退出当前账户吗？</view>
    <view class="alert-actions">
      <view class="alert-btn" bindtap="onCancelLogout">取消</view>
      <view class="alert-btn alert-btn-bold alert-btn-danger" bindtap="onDoLogout">确认退出</view>
    </view>
  </view>
</view>

<!-- ===== 互借记录弹框（对齐管理页审批弹框样式） ===== -->
<view class="record-sheet-overlay" wx:if="{{showRecordSheet && recordSheetType === CONTENT_TYPE.IDLE}}" catchtouchmove="preventTouchMove" bindtap="onCloseRecordSheet"></view>
<view class="record-sheet" wx:if="{{showRecordSheet && recordSheetType === CONTENT_TYPE.IDLE}}">
  <view class="record-sheet-header">
    <view class="record-sheet-handle"></view>
    <view class="record-sheet-title">互助记录详情</view>
  </view>
  <scroll-view class="record-sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 物品 + 借用时长 -->
    <view class="approval-section">
      <text class="approval-section-label">物品</text>
      <text class="approval-item-title">{{recordSheetItem.title}}</text>
      <view class="approval-duration-row">
        <text class="approval-duration-label">借用时长：</text>
        <text class="approval-duration-value">{{recordSheetItem.maxDuration}}{{(recordSheetItem.durationUnit === 'hour' ? '小时' : '天')}}</text>
      </view>
    </view>

    <!-- 借出方 -->
    <view class="approval-section">
      <text class="approval-section-label">{{recordSheetParties.left.label}}</text>
      <view class="approval-resident-card">
        <view class="approval-resident-row">
          <text class="approval-resident-addr approval-resident-addr-link" wx:if="{{recordSheetParties.left.personId}}" catchtap="onTapChatWithUser" data-user-id="{{recordSheetParties.left.personId}}" data-user-name="{{recordSheetParties.left.name}}">{{recordSheetParties.left.name}}</text>
          <text class="approval-resident-addr" wx:else>{{recordSheetParties.left.name}}</text>
          <view class="approval-rating-inline">
            <view class="approval-rating-score-row" wx:if="{{recordSheetParties.left.ratingText}}">
              <text class="approval-rating-label">获评</text>
              <text class="approval-rating-value">{{recordSheetParties.left.ratingText}}</text>
              <text class="approval-rating-unit">/ 5.0</text>
            </view>
            <text wx:else class="approval-rating-label">对方还未评分</text>
          </view>
        </view>
        <text class="record-feedback-text">互助感想：{{recordSheetParties.left.feedback || '无'}}</text>
      </view>
    </view>

    <!-- 借入方 -->
    <view class="approval-section">
      <text class="approval-section-label">{{recordSheetParties.right.label}}</text>
      <view class="approval-resident-card">
        <view class="approval-resident-row">
          <text class="approval-resident-addr approval-resident-addr-link" wx:if="{{recordSheetParties.right.personId}}" catchtap="onTapChatWithUser" data-user-id="{{recordSheetParties.right.personId}}" data-user-name="{{recordSheetParties.right.name}}">{{recordSheetParties.right.name}}</text>
          <text class="approval-resident-addr" wx:else>{{recordSheetParties.right.name}}</text>
          <view class="approval-rating-inline">
            <view class="approval-rating-score-row" wx:if="{{recordSheetParties.right.ratingText}}">
              <text class="approval-rating-label">获评</text>
              <text class="approval-rating-value">{{recordSheetParties.right.ratingText}}</text>
              <text class="approval-rating-unit">/ 5.0</text>
            </view>
            <text wx:else class="approval-rating-label">对方还未评分</text>
          </view>
        </view>
        <text class="record-feedback-text">互助感想：{{recordSheetParties.right.feedback || '无'}}</text>
      </view>
    </view>

    <!-- 物品状况（借出前） -->
    <view class="approval-section">
      <text class="approval-section-label">物品状况（借出前）</text>
      <text class="approval-note-text">{{recordSheetItem.condition === 'like-new' ? '几乎全新' : (recordSheetItem.condition === 'normal' || recordSheetItem.condition === 'good' ? '正常使用痕迹' : (recordSheetItem.condition === 'worn' ? '有明显磨损' : (recordSheetItem.condition || '—')))}}</text>
    </view>

    <!-- 物品状况（借出后） -->
    <view class="approval-section">
      <text class="approval-section-label">物品状况（借出后）</text>
      <text class="approval-note-text">{{recordSheetItem.damageType === 'normal' ? '正常损耗' : (recordSheetItem.damageType === 'severe' ? '非正常损坏' : (recordSheetItem.damageType === 'broken' ? '完全损坏' : (recordSheetItem.damageType || '—')))}}</text>
    </view>

    <!-- 归还情况 -->
    <view class="approval-section">
      <text class="approval-section-label">归还情况</text>
      <text class="approval-note-text" style="{{recordSheetItem.isOnTime === false ? 'color:var(--red);' : ''}}">{{recordSheetItem.isOnTime === false ? '逾期归还' : (recordSheetItem.isOnTime === true ? '按时归还' : '—')}}</text>
    </view>
    <view style="height:40rpx;"></view>
  </scroll-view>
</view>

<!-- ===== 互助记录弹框（对齐管理页审批弹框样式） ===== -->
<view class="record-sheet-overlay" wx:if="{{showRecordSheet && recordSheetType === CONTENT_TYPE.HELP}}" catchtouchmove="preventTouchMove" bindtap="onCloseRecordSheet"></view>
<view class="record-sheet" wx:if="{{showRecordSheet && recordSheetType === CONTENT_TYPE.HELP}}" style="height: 60vh;">
  <view class="record-sheet-header">
    <view class="record-sheet-handle"></view>
    <view class="record-sheet-title">互助记录详情</view>
  </view>
  <scroll-view class="record-sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 标题 + 时间段 -->
    <view class="approval-section">
      <text class="approval-section-label">标题</text>
      <text class="approval-item-title">{{recordSheetItem.title}}</text>
      <view class="approval-duration-row" wx:if="{{recordSheetItem.timeStart || recordSheetItem.timeEnd}}">
        <text class="approval-duration-label">时间段：</text>
        <text class="approval-duration-value">{{recordSheetItem.timeStart && recordSheetItem.timeEnd ? (recordSheetItem.timeStart + ' ~ ' + recordSheetItem.timeEnd) : (recordSheetItem.timeStart || recordSheetItem.timeEnd)}}</text>
      </view>
    </view>

    <!-- 帮助方 -->
    <view class="approval-section">
      <text class="approval-section-label">{{recordSheetParties.left.label}}</text>
      <view class="approval-resident-card">
        <view class="approval-resident-row">
          <text class="approval-resident-addr approval-resident-addr-link" wx:if="{{recordSheetParties.left.personId}}" catchtap="onTapChatWithUser" data-user-id="{{recordSheetParties.left.personId}}" data-user-name="{{recordSheetParties.left.name}}">{{recordSheetParties.left.name}}</text>
          <text class="approval-resident-addr" wx:else>{{recordSheetParties.left.name}}</text>
          <view class="approval-rating-inline">
            <view class="approval-rating-score-row" wx:if="{{recordSheetParties.left.ratingText}}">
              <text class="approval-rating-label">获评</text>
              <text class="approval-rating-value">{{recordSheetParties.left.ratingText}}</text>
              <text class="approval-rating-unit">/ 5.0</text>
            </view>
            <text wx:else class="approval-rating-label">对方还未评分</text>
          </view>
        </view>
        <text class="record-feedback-text">互助感想：{{recordSheetParties.left.feedback || '无'}}</text>
      </view>
    </view>

    <!-- 求助方 -->
    <view class="approval-section">
      <text class="approval-section-label">{{recordSheetParties.right.label}}</text>
      <view class="approval-resident-card">
        <view class="approval-resident-row">
          <text class="approval-resident-addr approval-resident-addr-link" wx:if="{{recordSheetParties.right.personId}}" catchtap="onTapChatWithUser" data-user-id="{{recordSheetParties.right.personId}}" data-user-name="{{recordSheetParties.right.name}}">{{recordSheetParties.right.name}}</text>
          <text class="approval-resident-addr" wx:else>{{recordSheetParties.right.name}}</text>
          <view class="approval-rating-inline">
            <view class="approval-rating-score-row" wx:if="{{recordSheetParties.right.ratingText}}">
              <text class="approval-rating-label">获评</text>
              <text class="approval-rating-value">{{recordSheetParties.right.ratingText}}</text>
              <text class="approval-rating-unit">/ 5.0</text>
            </view>
            <text wx:else class="approval-rating-label">对方还未评分</text>
          </view>
        </view>
        <text class="record-feedback-text">互助感想：{{recordSheetParties.right.feedback || '无'}}</text>
      </view>
    </view>
    <view style="height:40rpx;"></view>
  </scroll-view>
</view>
