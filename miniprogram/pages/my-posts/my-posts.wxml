            <image class="pill-icon" src="../../images/icon-ball.svg" mode="aspectFit" />
            <text>运动</text>
          </view>
          <view class="pill {{editCategory === '玩具' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="玩具">
            <image class="pill-icon" src="../../images/icon-gamepad.svg" mode="aspectFit" />
            <text>玩具</text>
          </view>
          <view class="pill {{editCategory === '服饰' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="服饰">
            <image class="pill-icon" src="../../images/icon-shirt.svg" mode="aspectFit" />
            <text>服饰</text>
          </view>
          <view class="pill {{editCategory === '其他' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="其他">
            <image class="pill-icon" src="../../images/icon-info.svg" mode="aspectFit" />
            <text>其他</text>
          </view>
        </view>
        <input class="edit-input" wx:if="{{editCategory === '其他'}}" type="text" value="{{editCustomType}}" bindinput="onEditInput" data-field="editCustomType" placeholder="手动输入类型" style="margin-top:16rpx;" />
      </view>

      <view class="input-group">
        <text class="edit-input-label">参考价格（人民币）</text>
        <input class="edit-input" type="digit" value="{{editPrice}}" bindinput="onEditInput" data-field="editPrice" placeholder="用于损坏赔偿基准" />
      </view>

      <view class="input-group">
        <text class="edit-input-label">物品详细描述</text>
        <textarea class="edit-textarea" value="{{editDesc}}" bindinput="onEditInput" data-field="editDesc" placeholder="描述物品现状、使用痕迹、附件清单、借用注意事项等" />
      </view>

      <view class="input-group">
        <text class="edit-input-label">借出时长</text>
        <view class="segment" style="margin:0;">
          <view class="segment-item {{editDurationUnit === 'day' ? 'active' : ''}}" bindtap="onEditUnitTap" data-value="day">按天</view>
          <view class="segment-item {{editDurationUnit === 'hour' ? 'active' : ''}}" bindtap="onEditUnitTap" data-value="hour">按小时</view>
        </view>
        <picker class="select-wrap" mode="selector" range="{{editDurationOptions}}" value="{{editDurationIndex}}" bindchange="onEditDurationChange">
          <view class="select">{{editDurationOptions[editDurationIndex]}}</view>
        </picker>
      </view>

      <view class="input-group">
        <text class="edit-input-label">借出形式</text>
        <view class="segment" style="margin:0;">
          <view class="segment-item {{editPickupMethod === 'self_pickup' ? 'active' : ''}}" bindtap="onEditPickupTap" data-value="self_pickup">需自提</view>
          <view class="segment-item {{editPickupMethod === 'both' ? 'active' : ''}}" bindtap="onEditPickupTap" data-value="both">自提 / 可送上门</view>
        </view>
      </view>

      <view class="input-group" style="margin-bottom:20rpx;">
        <text class="edit-input-label">物品状况</text>
        <view class="segment" style="margin:0;">
          <view class="segment-item {{editCondition === 'like-new' ? 'active' : ''}}" bindtap="onEditConditionTap" data-value="like-new">几乎全新</view>
          <view class="segment-item {{editCondition === 'normal' ? 'active' : ''}}" bindtap="onEditConditionTap" data-value="normal">正常使用痕迹</view>
          <view class="segment-item {{editCondition === 'worn' ? 'active' : ''}}" bindtap="onEditConditionTap" data-value="worn">有明显磨损</view>
        </view>
      </view>

    </block>

    <!-- ===== WANTED: 需求借入 ===== -->
    <block wx:if="{{editPostType === POST_TYPE.WANTED}}">

      <view class="input-group">
        <text class="edit-input-label">物品名称</text>
        <input class="edit-input" type="text" value="{{editTitle}}" bindinput="onEditInput" data-field="editTitle" placeholder="例：博世冲击钻套装 GBH 2-20" />
      </view>

      <view class="input-group">
        <text class="edit-input-label">物品类型</text>
        <view class="pill-row">
          <view class="pill {{editCategory === '工具' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="工具">
            <image class="pill-icon" src="../../images/icon-wrench.svg" mode="aspectFit" />
            <text>工具</text>
          </view>
          <view class="pill {{editCategory === '电子产品' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="电子产品">
            <image class="pill-icon" src="../../images/icon-phone.svg" mode="aspectFit" />
            <text>电子产品</text>
          </view>
          <view class="pill {{editCategory === '书籍' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="书籍">
            <image class="pill-icon" src="../../images/icon-book.svg" mode="aspectFit" />
            <text>书籍</text>
          </view>
          <view class="pill {{editCategory === '家居' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="家居">
            <image class="pill-icon" src="../../images/icon-home.svg" mode="aspectFit" />
            <text>家居</text>
          </view>
          <view class="pill {{editCategory === '运动' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="运动">
            <image class="pill-icon" src="../../images/icon-ball.svg" mode="aspectFit" />
            <text>运动</text>
          </view>
          <view class="pill {{editCategory === '玩具' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="玩具">
            <image class="pill-icon" src="../../images/icon-gamepad.svg" mode="aspectFit" />
            <text>玩具</text>
          </view>
          <view class="pill {{editCategory === '服饰' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="服饰">
            <image class="pill-icon" src="../../images/icon-shirt.svg" mode="aspectFit" />
            <text>服饰</text>
          </view>
          <view class="pill {{editCategory === '其他' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="其他">
            <image class="pill-icon" src="../../images/icon-info.svg" mode="aspectFit" />
            <text>其他</text>
          </view>
        </view>
        <input class="edit-input" wx:if="{{editCategory === '其他'}}" type="text" value="{{editCustomType}}" bindinput="onEditInput" data-field="editCustomType" placeholder="手动输入类型" style="margin-top:16rpx;" />
      </view>

      <view class="input-group">
        <text class="edit-input-label">用途说明</text>
        <textarea class="edit-textarea" value="{{editDesc}}" bindinput="onEditInput" data-field="editDesc" placeholder="请描述您需要借用此物品的原因和用途，让出借人更好地了解您的需求" />
      </view>

      <view class="input-group" style="margin-bottom:0;">
        <text class="edit-input-label">期望借用时长</text>
        <view class="segment" style="margin:0;">
          <view class="segment-item {{editDurationUnit === 'day' ? 'active' : ''}}" bindtap="onEditUnitTap" data-value="day">按天</view>
          <view class="segment-item {{editDurationUnit === 'hour' ? 'active' : ''}}" bindtap="onEditUnitTap" data-value="hour">按小时</view>
        </view>
        <picker class="select-wrap" mode="selector" range="{{editDurationOptions}}" value="{{editDurationIndex}}" bindchange="onEditDurationChange">
          <view class="select">{{editDurationOptions[editDurationIndex]}}</view>
        </picker>
      </view>

    </block>

    <!-- ===== HELP: 技能求助 ===== -->
    <block wx:if="{{editPostType === POST_TYPE.HELP}}">

      <view class="input-group">
        <text class="edit-input-label">求助标题</text>
        <input class="edit-input" type="text" value="{{editTitle}}" bindinput="onEditInput" data-field="editTitle" placeholder="简要描述你需要的帮助" />
      </view>

      <view class="input-group">
        <text class="edit-input-label">求助类型</text>
        <view class="pill-row">
          <view class="pill {{editCategory === '维修' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="维修">
            <image class="pill-icon" src="../../images/icon-wrench.svg" mode="aspectFit" />
            <text>维修</text>
          </view>
          <view class="pill {{editCategory === '陪护' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="陪护">
            <image class="pill-icon" src="../../images/icon-users.svg" mode="aspectFit" />
            <text>陪护</text>
          </view>
          <view class="pill {{editCategory === '代取' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="代取">
            <image class="pill-icon" src="../../images/icon-download.svg" mode="aspectFit" />
            <text>代取</text>
          </view>
          <view class="pill {{editCategory === '搬运' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="搬运">
            <image class="pill-icon" src="../../images/icon-download.svg" mode="aspectFit" />
            <text>搬运</text>
          </view>
          <view class="pill {{editCategory === '辅导' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="辅导">
            <image class="pill-icon" src="../../images/icon-book.svg" mode="aspectFit" />
            <text>辅导</text>
          </view>
          <view class="pill {{editCategory === '遛宠' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="遛宠">
            <image class="pill-icon" src="../../images/icon-heart.svg" mode="aspectFit" />
            <text>遛宠</text>
          </view>
          <view class="pill {{editCategory === '烹饪' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="烹饪">
            <image class="pill-icon" src="../../images/icon-heart.svg" mode="aspectFit" />
            <text>烹饪</text>
          </view>
          <view class="pill {{editCategory === '其他' ? 'selected' : ''}}" bindtap="onEditCategoryTap" data-value="其他">
            <image class="pill-icon" src="../../images/icon-info.svg" mode="aspectFit" />
            <text>其他</text>
          </view>
        </view>
        <input class="edit-input" wx:if="{{editCategory === '其他'}}" type="text" value="{{editCustomType}}" bindinput="onEditInput" data-field="editCustomType" placeholder="手动输入求助类型" style="margin-top:16rpx;" />
      </view>

      <view class="input-group">
        <text class="edit-input-label">详细描述</text>
        <textarea class="edit-textarea" value="{{editDesc}}" bindinput="onEditInput" data-field="editDesc" placeholder="描述具体情况、需要什么帮助、大概需要多长时间等" />
      </view>

      <!-- 预计时间范围（选填，开关控制） -->
      <view class="input-group">
        <view class="label-with-switch">
          <text class="edit-input-label" style="margin:0;">预计时间范围（选填）</text>
          <switch class="time-switch" checked="{{editEnableTimeRange}}" bindchange="onEditToggleTimeRange" color="#0071e3" />
        </view>
        <block wx:if="{{editEnableTimeRange}}">
          <view class="time-row">
            <text class="time-label">从</text>
            <picker class="time-picker" mode="date" value="{{editTimeStartDate}}" bindchange="onEditTimeStartDateChange">
              <view class="time-value">{{editTimeStartDate || '请选择日期'}}</view>
            </picker>
            <picker class="time-picker" mode="selector" range="{{hourOptions}}" value="{{editTimeStartHour}}" bindchange="onEditTimeStartHourChange">
              <view class="time-value">{{hourOptions[editTimeStartHour]}}</view>
            </picker>
          </view>
          <view class="time-row">
            <text class="time-label">至</text>
            <picker class="time-picker" mode="date" value="{{editTimeEndDate}}" bindchange="onEditTimeEndDateChange">
              <view class="time-value">{{editTimeEndDate || '请选择日期'}}</view>
            </picker>
            <picker class="time-picker" mode="selector" range="{{hourOptions}}" value="{{editTimeEndHour}}" bindchange="onEditTimeEndHourChange">
              <view class="time-value">{{hourOptions[editTimeEndHour]}}</view>
            </picker>
          </view>
        </block>
        <view wx:else class="time-hint">打开开关可设置期望的帮助时间范围，不设置则表示时间灵活</view>
      </view>

      <view class="input-group" style="margin-bottom:0;">
        <text class="edit-input-label">紧急程度</text>
        <view class="segment" style="margin:0;">
          <view class="segment-item {{editUrgency === 'normal' ? 'active' : ''}}" bindtap="onEditUrgencyTap" data-value="normal">一般</view>
          <view class="segment-item {{editUrgency === 'urgent' ? 'active' : ''}}" bindtap="onEditUrgencyTap" data-value="urgent">紧急</view>
        </view>
      </view>

    </block>

    <!-- 图片区域 -->
    <view class="input-group" style="margin-top:20rpx;">
      <text class="edit-input-label">图片（选填，最多 4 张）</text>
      <view class="img-upload-grid">
        <block wx:for="{{editImages}}" wx:key="*this">
          <view class="img-upload-item" bindtap="onEditPreviewImage" data-index="{{index}}">
            <image class="upload-img" src="{{item}}" mode="aspectFill" />
            <view class="img-delete" catchtap="onEditRemoveImage" data-index="{{index}}">×</view>
          </view>
        </block>
        <view class="img-upload-item img-add-btn" wx:if="{{editImages.length < 4}}" catchtap="onEditAddImage">
          <text class="add-plus">+</text>
        </view>
      </view>
    </view>

    <view style="height:20rpx;"></view>
  </scroll-view>
  <view class="edit-sheet-footer">
    <view class="edit-sheet-footer-row">
    <view class="edit-save-btn" bindtap="onSaveEdit">{{editSource === POST_STATUS.DRAFT ? '重新发布' : '保存'}}</view>
    </view>
  </view>
</view>

<!-- ===== Approval Sheet (bottom sheet: fixed header + scroll body + fixed footer) ===== -->
<view class="approval-sheet-overlay" wx:if="{{showApprovalSheet}}" catchtouchmove="preventTouchMove" bindtap="onCloseApprovalSheet"></view>
<view class="approval-sheet" wx:if="{{showApprovalSheet}}">
  <view class="approval-sheet-header">
    <view class="approval-sheet-handle"></view>
    <view class="approval-sheet-title">审批</view>
  </view>

  <scroll-view class="approval-sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 标题行：闲置物品用"物品"，求助用"求助标题" -->
    <view class="approval-section">
      <text class="approval-section-label">{{approvalSheetItem.approvalType === ACTIVITY_ROLE.HELP ? '求助标题' : '物品'}}</text>
      <text class="approval-item-title">{{approvalSheetItem.itemTitle}}</text>
      <!-- 借入/借出类型：显示对方期望的可借出时长 -->
      <view class="approval-duration-row" wx:if="{{approvalSheetItem.maxDuration && (approvalSheetItem.approvalType === ACTIVITY_ROLE.BORROW || approvalSheetItem.approvalType === ACTIVITY_ROLE.LEND)}}">
        <text class="approval-duration-label">可借出时长：</text>
        <text class="approval-duration-value">{{approvalSheetItem.maxDuration}}{{(approvalSheetItem.durationUnit === 'hour' ? '小时' : '天')}}</text>
      </view>
      <!-- 求助类型：显示时间段 -->
      <view class="approval-duration-row" wx:if="{{approvalSheetItem.approvalType === ACTIVITY_ROLE.HELP}}">
        <text class="approval-duration-label">时间段：</text>
        <text class="approval-duration-value">{{approvalSheetItem.timeStart && approvalSheetItem.timeEnd ? (approvalSheetItem.timeStart + ' ~ ' + approvalSheetItem.timeEnd) : '--'}}</text>
      </view>
    </view>

    <!-- 求助类型：备注（帮住者填写的说明） -->
    <view class="approval-section" wx:if="{{approvalSheetItem.approvalType === ACTIVITY_ROLE.HELP}}">
      <text class="approval-section-label">备注</text>
      <text class="approval-note-text">{{approvalSheetItem.note || '无'}}</text>
    </view>

    <!-- 借入/借出类型：申请人备注 -->
    <view class="approval-section" wx:elif="{{approvalSheetItem.note}}">
      <text class="approval-section-label">{{approvalSheetItem.postType === POST_TYPE.WANTED ? '借出说明' : '借入说明'}}</text>
      <text class="approval-note-text">{{approvalSheetItem.note}}</text>
    </view>

    <!-- 申请人信息 -->
    <view class="approval-section">
      <text class="approval-section-label">{{approvalSheetItem.approvalType === ACTIVITY_ROLE.BORROW ? '愿意借出的住户' : (approvalSheetItem.approvalType === ACTIVITY_ROLE.LEND ? '希望借用的住户' : '主动帮忙的住户')}}</text>
      <view class="approval-resident-card">
        <view class="approval-resident-row">
          <text class="approval-resident-addr approval-resident-addr-link" wx:if="{{approvalSheetItem.applicantUserId}}" catchtap="onTapChatWithUser" data-user-id="{{approvalSheetItem.applicantUserId}}" data-user-name="{{approvalSheetItem.applicantName}}">{{approvalSheetItem.applicantAddress}}</text>
          <text class="approval-resident-addr" wx:else>{{approvalSheetItem.applicantAddress}}</text>
          <view class="approval-rating-inline">
            <text class="approval-rating-label">综合评分</text>
            <view class="approval-rating-score-row">
              <text class="approval-rating-value">{{approvalSheetItem.applicantRating}}</text>
              <text class="approval-rating-unit">/ 5.0</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 统计数据 -->
    <view class="approval-section">
      <text class="approval-section-label">互助记录</text>
      <view class="approval-stats-grid">
        <view class="approval-stat-item approval-stat-half">
          <text class="approval-stat-value">{{approvalSheetItem.borrowCount}} 次</text>
          <text class="approval-stat-label">借入</text>
        </view>
        <view class="approval-stat-item approval-stat-half">
          <text class="approval-stat-value">{{approvalSheetItem.borrowReturnRate}}%</text>
          <text class="approval-stat-label">按时归还率</text>
        </view>
        <view class="approval-stat-item">
          <text class="approval-stat-value">{{approvalSheetItem.lendCount}} 次</text>
          <text class="approval-stat-label">借出</text>
        </view>
        <view class="approval-stat-item">
          <text class="approval-stat-value">{{approvalSheetItem.helpReqCount}} 次</text>
          <text class="approval-stat-label">求助</text>
        </view>
        <view class="approval-stat-item">
          <text class="approval-stat-value">{{approvalSheetItem.helpProCount}} 次</text>
          <text class="approval-stat-label">帮助他人</text>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="approval-tip">
      <view class="approval-tip-header">
        <text class="approval-tip-icon">💡</text>
        <text class="approval-tip-title">温馨提示</text>
      </view>
      <text class="approval-tip-text">您可以根据对方的过往记录来判断是否{{approvalSheetItem.approvalType === ACTIVITY_ROLE.HELP ? '接受帮助' : (approvalSheetItem.approvalType === ACTIVITY_ROLE.BORROW ? '确认借用' : '同意借给')}}{{approvalSheetItem.approvalType === ACTIVITY_ROLE.BORROW ? '愿意借出的住户' : (approvalSheetItem.approvalType === ACTIVITY_ROLE.LEND ? '希望借用的住户' : '主动帮忙的住户')}}，良好的互助记录通常意味着更可靠的合作体验。</text>
    </view>
    <view style="height:20rpx;"></view>
  </scroll-view>

  <view class="approval-sheet-footer">
    <view class="approval-footer-row">
      <view class="approval-confirm-btn" bindtap="onConfirmApproval">{{approvalSheetItem.approvalType === ACTIVITY_ROLE.BORROW ? '确认借入' : '同意'}}</view>
      <view class="approval-reject-btn" bindtap="onRejectClick">拒绝</view>
    </view>
  </view>
</view>

<!-- ===== Progress Sheet (进行中 detail: fixed header + scroll body + fixed footer) ===== -->
<view class="progress-sheet-overlay" wx:if="{{showProgressSheet}}" catchtouchmove="preventTouchMove" bindtap="onCloseProgressSheet"></view>
<view class="progress-sheet" wx:if="{{showProgressSheet}}">
  <view class="progress-sheet-header">
    <view class="progress-sheet-handle"></view>
    <view class="progress-sheet-title">{{progressSheetType === ACTIVITY_ROLE.HELP_REQ || progressSheetType === ACTIVITY_ROLE.HELP_PRO ? '结束' : (progressSheetType === ACTIVITY_ROLE.LEND ? '确认归还' : '归还物品')}}</view>
  </view>

  <scroll-view class="progress-sheet-body" scroll-y enhanced show-scrollbar="{{false}}" style="padding-bottom: {{sheetPaddingBottom}}px;">
    <!-- 物品标题 -->
    <view class="approval-section">
      <text class="approval-section-label">{{progressSheetType === ACTIVITY_ROLE.HELP_REQ || progressSheetType === ACTIVITY_ROLE.HELP_PRO ? '标题' : '物品'}}</text>
      <text class="approval-item-title">{{progressSheetItem.itemTitle}}</text>
    </view>

    <!-- 备注（借入说明/借出说明/求助说明） -->
    <view class="approval-section" wx:if="{{progressSheetItem.note}}">
      <text class="approval-section-label">{{progressSheetType === ACTIVITY_ROLE.HELP_REQ ? '求助说明' : (progressSheetType === ACTIVITY_ROLE.HELP_PRO ? '帮助说明' : (progressSheetItem.postType === POST_TYPE.WANTED ? '借出说明' : '借入说明'))}}</text>
      <text class="approval-note-text">{{progressSheetItem.note}}</text>
    </view>

    <!-- 住户信息 -->
    <view class="approval-section">
      <text class="approval-section-label">{{progressSheetItem.roleLabel}}</text>
      <view class="approval-resident-card">
        <view class="approval-resident-row">
          <text class="approval-resident-addr approval-resident-addr-link" wx:if="{{progressSheetItem.personUserId}}" catchtap="onTapChatWithUser" data-user-id="{{progressSheetItem.personUserId}}" data-user-name="{{progressSheetItem.personName}}">{{progressSheetItem.personAddress}}</text>
          <text class="approval-resident-addr" wx:else>{{progressSheetItem.personAddress}}</text>
          <view class="approval-rating-inline">
            <text class="approval-rating-label">综合评分</text>
            <view class="approval-rating-score-row">
              <text class="approval-rating-value">{{progressSheetItem.personRating}}</text>
              <text class="approval-rating-unit">/ 5.0</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 归还时间（仅借入/借出） -->
    <view class="approval-section" wx:if="{{progressSheetType === ACTIVITY_ROLE.BORROW || progressSheetType === ACTIVITY_ROLE.LEND}}">
      <text class="approval-section-label">归还时间</text>
      <view class="progress-return-time {{progressSheetItem.isOverdue ? 'overdue' : ''}}">
        <text wx:if="{{progressSheetItem.isOverdue && progressSheetItem.remainingDays < 0 && -progressSheetItem.remainingDays >= 1}}">已超出归还时间 {{-progressSheetItem.remainingDays}} 天</text>
        <text wx:elif="{{progressSheetItem.isOverdue && progressSheetItem.remainingHours < 0 && -progressSheetItem.remainingHours > 0}}">已超出归还时间 {{-progressSheetItem.remainingHours}} 小时</text>
        <text wx:elif="{{progressSheetItem.isOverdue}}">已逾期</text>
        <text wx:elif="{{progressSheetItem.remainingHours > 0 && progressSheetItem.remainingHours < 24}}">剩余 {{progressSheetItem.remainingHours}} 小时归还</text>
        <text wx:elif="{{progressSheetItem.remainingDays === 0}}">今日应归还</text>
        <text wx:else>剩余 {{progressSheetItem.remainingDays}} 天归还</text>
      </view>
    </view>

    <!-- 使用后物品状况（借出专用，必填） -->
    <view class="approval-section" wx:if="{{progressSheetType === ACTIVITY_ROLE.LEND}}">
      <text class="approval-section-label">使用后物品状况 <text style="color:var(--red);">*</text></text>
      <view class="segment" style="margin:0;">
        <view class="segment-item {{progressSheetCondition === 'normal' ? 'active' : ''}}" bindtap="onProgressConditionTap" data-value="normal">正常损耗</view>
        <view class="segment-item {{progressSheetCondition === 'severe' ? 'active' : ''}}" bindtap="onProgressConditionTap" data-value="severe">非正常损坏</view>
        <view class="segment-item {{progressSheetCondition === 'broken' ? 'active' : ''}}" bindtap="onProgressConditionTap" data-value="broken">完全损坏</view>
      </view>
      <!-- 非正常损坏 / 完全损坏温馨提示 -->
      <view class="condition-warn-tip" wx:if="{{progressSheetCondition === 'severe' || progressSheetCondition === 'broken'}}">
        <text>💡 温馨提示：根据损坏程度，您有权向借用物品的住户申请修理费或赔偿费。相关事项请私下与住户协商，平台仅做记录。</text>
      </view>
    </view>

    <!-- 星级评分（必填） -->
    <view class="approval-section">
      <text class="approval-section-label">请为此次互助评分 <text style="color:var(--red);">*</text></text>
      <view class="progress-stars-row">
        <view class="progress-star {{progressSheetRating >= 1 ? 'active' : ''}}" bindtap="onProgressRatingTap" data-star="1">★</view>
        <view class="progress-star {{progressSheetRating >= 2 ? 'active' : ''}}" bindtap="onProgressRatingTap" data-star="2">★</view>
        <view class="progress-star {{progressSheetRating >= 3 ? 'active' : ''}}" bindtap="onProgressRatingTap" data-star="3">★</view>
        <view class="progress-star {{progressSheetRating >= 4 ? 'active' : ''}}" bindtap="onProgressRatingTap" data-star="4">★</view>
        <view class="progress-star {{progressSheetRating >= 5 ? 'active' : ''}}" bindtap="onProgressRatingTap" data-star="5">★</view>
      </view>
    </view>

    <!-- 反馈（选填） -->
    <view class="approval-section">
      <view class="feedback-label-row">
        <text class="approval-section-label">互助感想（选填）</text>
        <view class="feedback-generate-btn {{_generatingFeedback ? 'btn-disabled' : ''}}" bindtap="onGenerateFeedback" data-source="progress">智能生成</view>
      </view>
      <textarea class="progress-feedback-input" value="{{progressSheetFeedback}}" bindinput="onProgressFeedbackInput" placeholder="分享一下此次互助的感受…" maxlength="200" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
    </view>
    <view style="height:20rpx;"></view>
  </scroll-view>

  <view class="progress-sheet-footer">
    <view class="progress-confirm-btn" bindtap="onConfirmReturn">{{progressSheetType === ACTIVITY_ROLE.HELP_REQ || progressSheetType === ACTIVITY_ROLE.HELP_PRO ? '结束' : (progressSheetType === ACTIVITY_ROLE.LEND ? '对方已归还' : '我已归还')}}</view>
  </view>
</view>

<!-- ===== Completed Sheet (已完成 detail — fixed header + scroll body) ===== -->
<view class="completed-sheet-overlay" wx:if="{{showCompletedSheet}}" catchtouchmove="preventTouchMove" bindtap="onCloseCompletedSheet"></view>
<view class="completed-sheet" wx:if="{{showCompletedSheet}}">
  <view class="completed-sheet-header">
    <view class="completed-sheet-handle"></view>
    <view class="completed-sheet-title">互助详情</view>
  </view>

  <scroll-view class="completed-sheet-body" scroll-y enhanced show-scrollbar="{{false}}" style="padding-bottom: {{sheetPaddingBottom}}px;">
    <!-- 物品标题 -->
    <view class="approval-section">
      <text class="approval-section-label">{{completedSheetItem.type === ACTIVITY_ROLE.HELP_REQ || completedSheetItem.type === ACTIVITY_ROLE.HELP_PRO ? '标题' : '物品'}}</text>
      <text class="approval-item-title">{{completedSheetItem.itemTitle}}</text>
    </view>

    <!-- 备注（借入说明/借出说明/求助说明） -->
    <view class="approval-section" wx:if="{{completedSheetItem.note}}">
      <text class="approval-section-label">{{completedSheetItem.type === ACTIVITY_ROLE.HELP_REQ || completedSheetItem.type === ACTIVITY_ROLE.HELP_PRO ? '求助说明' : (completedSheetItem.postType === POST_TYPE.WANTED ? '借出说明' : '借入说明')}}</text>
      <text class="approval-note-text">{{completedSheetItem.note}}</text>
    </view>

    <!-- 对方信息 -->
    <view class="approval-section">
      <text class="approval-section-label">{{completedSheetItem.roleLabel}}</text>
      <view class="approval-resident-card">
        <view class="approval-resident-row">
          <text class="approval-resident-addr approval-resident-addr-link" wx:if="{{completedSheetItem.personUserId}}" catchtap="onTapChatWithUser" data-user-id="{{completedSheetItem.personUserId}}" data-user-name="{{completedSheetItem.personName}}">{{completedSheetItem.personAddress}}</text>
          <text class="approval-resident-addr" wx:else>{{completedSheetItem.personAddress}}</text>
        </view>
      </view>
    </view>

    <!-- 使用后物品状况（借出方专用：已填写则展示，未填写则提供补填入口） -->
    <view class="approval-section" wx:if="{{completedSheetItem.type === ACTIVITY_ROLE.LEND}}">
      <text class="approval-section-label">使用后物品状况 <text style="color:var(--red);">*</text></text>
      <view wx:if="{{completedSheetItem.damageType}}" class="completed-damage-display">
        <text class="completed-damage-text">{{completedSheetItem.damageType === 'normal' ? '正常损耗' : completedSheetItem.damageType === 'severe' ? '非正常损坏' : completedSheetItem.damageType === 'broken' ? '完全损坏' : completedSheetItem.damageType}}</text>
      </view>
      <view wx:else>
        <view class="segment" style="margin:0;">
          <view class="segment-item {{completedDamageType === 'normal' ? 'active' : ''}}" bindtap="onCompletedDamageTap" data-value="normal">正常损耗</view>
          <view class="segment-item {{completedDamageType === 'severe' ? 'active' : ''}}" bindtap="onCompletedDamageTap" data-value="severe">非正常损坏</view>
          <view class="segment-item {{completedDamageType === 'broken' ? 'active' : ''}}" bindtap="onCompletedDamageTap" data-value="broken">完全损坏</view>
        </view>
      </view>
    </view>

    <!-- 互助评分 (both sides) -->
    <view class="approval-section">
      <text class="approval-section-label">互助评分</text>
      <view class="completed-rating-grid">
        <view class="completed-rating-card">
          <text class="completed-rating-card-label">我给对方的评分</text>
          <view wx:if="{{completedSheetItem.myRating !== null}}" class="completed-rating-value-row">
            <text class="completed-rating-score">{{completedSheetItem.myRating}}</text>
            <text class="completed-rating-unit">/ 5.0</text>
          </view>
          <text wx:else class="completed-rating-pending">未评分</text>
        </view>
        <view class="completed-rating-card">
          <text class="completed-rating-card-label">对方给我的评分</text>
          <view wx:if="{{completedSheetItem.theirRating !== null}}" class="completed-rating-value-row">
            <text class="completed-rating-score">{{completedSheetItem.theirRating}}</text>
            <text class="completed-rating-unit">/ 5.0</text>
          </view>
          <text wx:else class="completed-rating-pending">未评分</text>
        </view>
      </view>
    </view>

    <!-- 补充评价入口：本方尚未评分时可在此评价对方 -->
    <view class="approval-section" wx:if="{{completedSheetItem.myRating === null}}">
      <text class="approval-section-label">请为此次互助评分 <text style="color:var(--red);">*</text></text>
      <view class="progress-stars-row">
        <view class="progress-star {{completedRating >= 1 ? 'active' : ''}}" bindtap="onCompletedRatingTap" data-star="1">★</view>
        <view class="progress-star {{completedRating >= 2 ? 'active' : ''}}" bindtap="onCompletedRatingTap" data-star="2">★</view>
        <view class="progress-star {{completedRating >= 3 ? 'active' : ''}}" bindtap="onCompletedRatingTap" data-star="3">★</view>
        <view class="progress-star {{completedRating >= 4 ? 'active' : ''}}" bindtap="onCompletedRatingTap" data-star="4">★</view>
        <view class="progress-star {{completedRating >= 5 ? 'active' : ''}}" bindtap="onCompletedRatingTap" data-star="5">★</view>
      </view>
      <view class="feedback-label-row" style="margin-top:12px;">
        <text class="approval-section-label">互助感想</text>
        <view class="feedback-generate-btn {{_generatingFeedback ? 'btn-disabled' : ''}}" bindtap="onGenerateFeedback" data-source="completed">智能生成</view>
      </view>
      <textarea class="progress-feedback-input" style="margin-top:8px;" value="{{completedFeedback}}" bindinput="onCompletedFeedbackInput" placeholder="分享一下此次互助的感受…" maxlength="200" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
      <view class="progress-confirm-btn" style="margin-top:12px;" bindtap="onSubmitCompletedRating">提交评价</view>
    </view>

    <!-- 互助感想 (both sides) -->
    <view class="approval-section">
      <text class="approval-section-label">互助感想</text>
      <view class="completed-feedback-list">
        <view class="completed-feedback-card">
          <text class="completed-feedback-card-label">我的感想</text>
          <text class="completed-feedback-text">{{completedSheetItem.myFeedback || '无'}}</text>
        </view>
        <view class="completed-feedback-card">
          <text class="completed-feedback-card-label">对方感想</text>
          <text class="completed-feedback-text">{{completedSheetItem.theirFeedback || '无'}}</text>
        </view>
      </view>
    </view>
    <view style="height:20rpx;"></view>
  </scroll-view>
</view>

<!-- ===== Confirm Alert (approve / reject) ===== -->
<view class="alert-overlay" wx:if="{{showConfirmAlert}}" catchtap="onCancelConfirm">
  <view class="alert" catchtap="">
    <view class="alert-title">{{confirmAlertTitle}}</view>
    <view class="alert-body">{{confirmAlertBody}}</view>
    <!-- 拒绝理由（开关控制，仅在拒绝时显示） -->
    <view wx:if="{{confirmAction === 'reject'}}" class="alert-reject-section">
      <view class="label-with-switch" catchtap="preventTouchMove">
        <text class="reject-switch-label">填写拒绝理由</text>
        <switch checked="{{enableRejectReason}}" bindchange="onToggleRejectReason" color="#0071e3" />
      </view>
      <block wx:if="{{enableRejectReason}}">
        <textarea class="alert-reason-input" value="{{rejectReason}}" bindinput="onRejectReasonInput" placeholder="选填：说明拒绝原因" maxlength="200" auto-height catchtap="preventTouchMove" />
      </block>
    </view>
    <view class="alert-actions">
      <view class="alert-btn" bindtap="onCancelConfirm">取消</view>
      <view class="alert-btn alert-btn-bold" bindtap="onDoConfirm">确认</view>
    </view>
  </view>
</view>

<!-- ===== Return Confirm Alert ===== -->
<view class="alert-overlay" wx:if="{{showReturnConfirmAlert}}" catchtap="onCancelReturnConfirm">
  <view class="alert" catchtap="">
    <view class="alert-title">确认{{returnConfirmData.type === ACTIVITY_ROLE.HELP_REQ || returnConfirmData.type === ACTIVITY_ROLE.HELP_PRO ? '结束' : '归还'}}</view>
    <view class="alert-body">{{returnConfirmData.type === ACTIVITY_ROLE.HELP_REQ || returnConfirmData.type === ACTIVITY_ROLE.HELP_PRO ? '确认结束此次互助？' : (returnConfirmData.type === ACTIVITY_ROLE.LEND ? '确认对方已归还该物品？' : '确认我已归还该物品？')}}</view>
    <view class="alert-actions">
      <view class="alert-btn" bindtap="onCancelReturnConfirm">取消</view>
      <view class="alert-btn alert-btn-bold" bindtap="onDoReturn">确认</view>
    </view>
  </view>
</view>

<!-- ===== Overdue Tip Alert ===== -->
<view class="alert-overlay" wx:if="{{showOverdueTipAlert}}" catchtap="onCloseOverdueTip">
  <view class="alert" catchtap="">
    <view class="alert-title">温馨提示</view>
    <view class="alert-body">本次归还已超时，请下次务必按时归还。良好的信用记录有助于您在社区中获得更多互助机会。</view>
    <view class="alert-actions">
      <view class="alert-btn alert-btn-bold" bindtap="onCloseOverdueTip">我知道了</view>
    </view>
  </view>
</view>

<!-- ===== Save Confirm Alert (Edit Sheet) ===== -->
<view class="alert-overlay" wx:if="{{showSaveConfirmAlert}}" catchtap="onCancelSaveConfirm">
  <view class="alert" catchtap="">
    <view class="alert-title">{{editSource === POST_STATUS.DRAFT ? '确认重新发布' : '确认保存'}}</view>
    <view class="alert-body">{{editSource === POST_STATUS.DRAFT ? '重新发布内容经过审核后会公开展示，确认继续？' : '保存后需要重新审核，确认保存此次编辑？'}}</view>
    <view class="alert-actions">
      <view class="alert-btn" bindtap="onCancelSaveConfirm">取消</view>
      <view class="alert-btn alert-btn-bold" bindtap="onDoSave">确认</view>
    </view>
  </view>

</view>
