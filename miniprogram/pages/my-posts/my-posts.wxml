<!--
  my-posts 管理页 — 像素级对齐原型 my-posts.html
  原型路径: c-end/pages/my-posts.html
-->
<view class="container">

  <!-- 全局加载状态 -->
  <view class="global-loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 全局错误状态（仅在所有请求失败时展示） -->
  <view class="global-error" wx:elif="{{loadError}}">
    <text class="error-icon">⚠</text>
    <text class="error-text">{{loadErrorMsg}}</text>
    <view class="error-retry-btn" bindtap="onRetryLoad">点击重试</view>
  </view>

  <!-- 数据正常展示 -->
  <block wx:else>

  <!-- 一级标签（下划线风格）— 固定在系统导航栏下方 -->
  <view class="seg-wrap">
    <view class="main-tabs">
      <view class="main-tab {{mainTab === 'publish' ? 'active' : ''}}" bindtap="onMainTabTap" data-tab="publish">发布</view>
      <view class="main-tab {{mainTab === 'approval' ? 'active' : ''}}" bindtap="onMainTabTap" data-tab="approval">审批<text class="approval-badge" wx:if="{{approvalCount > 0}}">{{approvalCount > 99 ? '99+' : approvalCount}}</text></view>
      <view class="main-tab {{mainTab === 'inProgress' ? 'active' : ''}}" bindtap="onMainTabTap" data-tab="inProgress">进行中</view>
      <view class="main-tab {{mainTab === 'completed' ? 'active' : ''}}" bindtap="onMainTabTap" data-tab="completed">已完成<text class="rate-dot" wx:if="{{hasPendingRating}}"></text></view>
    </view>
  </view>

  <!-- ===== 发布 ===== -->
  <view wx:if="{{mainTab === 'publish'}}" class="panel-wrap">
    <view class="seg-sub-wrap">
      <view class="segment">
        <view class="segment-item {{publishSubTab === 'online' ? 'active' : ''}}" bindtap="onPublishSubTap" data-sub="online">
          在线中 <text class="seg-count">{{onlineCount}}</text>
        </view>
        <view class="segment-item {{publishSubTab === 'review' ? 'active' : ''}}" bindtap="onPublishSubTap" data-sub="review">
          审核中 <text class="seg-count">{{reviewCount}}</text>
          <text class="review-info-icon" catchtap="onReviewInfoTap">?</text>
        </view>
        <view class="segment-item {{publishSubTab === POST_STATUS.DRAFT ? 'active' : ''}}" bindtap="onPublishSubTap" data-sub="{{POST_STATUS.DRAFT}}">
          已下架 <text class="seg-count">{{offlineCount}}</text>
        </view>
      </view>
    </view>

    <scroll-view class="page-content" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullRefresh">
      <!-- 在线发布 -->
      <view wx:if="{{publishSubTab === 'online'}}">
        <block wx:for="{{onlinePosts}}" wx:key="id">
          <view class="post-card" bindtap="onOpenEdit" data-post="{{item}}" data-type="{{item.postType === POST_TYPE.HELP ? CONTENT_TYPE.HELP : CONTENT_TYPE.IDLE}}" data-source="online">
            <view class="post-img" style="background: {{item.iconBg}};">
              <image class="post-icon" src="{{item.iconSrc}}" mode="aspectFit" />
            </view>
            <view class="post-info">
              <text class="post-title">{{item.title}}</text>
              <view class="post-meta-row">
                <text class="tag tag-fill post-type-tag">{{item.typeLabel}}</text>
                <text class="post-time">· {{item.timeText}}</text>
              </view>
            </view>
            <view class="post-act-btn danger" catchtap="onConfirmOffline" data-id="{{item.id}}" data-post-type="{{item.postType}}">下架</view>
          </view>
        </block>
        <view class="list-end" wx:if="{{onlinePosts.length > 0}}">— 共 {{onlineCount}} 条在线发布 —</view>
        <view class="empty-state" wx:if="{{onlinePosts.length === 0}}">
          <text class="empty-text">暂无在线发布的物品或求助</text>
        </view>
      </view>

      <!-- 审核中发布 -->
      <view wx:if="{{publishSubTab === 'review'}}">
        <block wx:for="{{reviewPosts}}" wx:key="id">
          <view class="post-card post-card-review">
            <view class="post-img" style="background: #F5F5F5;">
              <image class="post-icon" src="../../images/icon-info.svg" mode="aspectFit" />
            </view>
            <view class="post-info">
              <text class="post-title">{{item.title}}</text>
              <view class="post-meta-row">
                <text class="tag tag-fill post-review-tag">审核中</text>
              </view>
            </view>
          </view>
        </block>
        <view class="list-end" wx:if="{{reviewPosts.length > 0}}">— 共 {{reviewCount}} 条审核中 —</view>
        <view class="empty-state" wx:if="{{reviewPosts.length === 0}}">
          <text class="empty-text">暂无审核中的发布</text>
        </view>
      </view>

      <!-- 已下架发布 -->
      <view wx:if="{{publishSubTab === POST_STATUS.DRAFT}}">
        <block wx:for="{{offlinePosts}}" wx:key="id">
          <view class="post-card" bindtap="onOpenEdit" data-post="{{item}}" data-type="{{item.postType === POST_TYPE.HELP ? CONTENT_TYPE.HELP : CONTENT_TYPE.IDLE}}" data-source="{{POST_STATUS.DRAFT}}">
            <view class="post-img" style="background: {{item.iconBg}};">
              <image class="post-icon" src="{{item.iconSrc}}" mode="aspectFit" />
            </view>
            <view class="post-info">
              <text class="post-title">{{item.title}}</text>
              <view class="post-meta-row">
                <text class="tag tag-fill post-type-tag">{{item.typeLabel}}</text>
                <text class="post-time">· {{item.timeText}}</text>
              </view>
            </view>
            <view class="post-act-btn primary" catchtap="onOpenEdit" data-post="{{item}}" data-type="{{item.postType === POST_TYPE.HELP ? CONTENT_TYPE.HELP : CONTENT_TYPE.IDLE}}" data-source="{{POST_STATUS.DRAFT}}">重新发布</view>
          </view>
        </block>
        <view class="list-end" wx:if="{{offlinePosts.length > 0}}">— 共 {{offlineCount}} 条已下架 —</view>
        <view class="empty-state" wx:if="{{offlinePosts.length === 0}}">
          <text class="empty-text">暂无已下架的发布</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 审批 ===== -->
  <view wx:if="{{mainTab === 'approval'}}" class="panel-wrap">
    <view class="seg-sub-wrap">
      <view class="segment">
        <view class="segment-item {{approvalSubTab === ACTIVITY_ROLE.BORROW ? 'active' : ''}}" bindtap="onApprovalSubTap" data-sub="{{ACTIVITY_ROLE.BORROW}}">
          借入 <text class="seg-count">{{borrowApprovals.length}}</text>
        </view>
        <view class="segment-item {{approvalSubTab === ACTIVITY_ROLE.LEND ? 'active' : ''}}" bindtap="onApprovalSubTap" data-sub="{{ACTIVITY_ROLE.LEND}}">
          借出 <text class="seg-count">{{lendApprovals.length}}</text>
        </view>
        <view class="segment-item {{approvalSubTab === ACTIVITY_ROLE.HELP ? 'active' : ''}}" bindtap="onApprovalSubTap" data-sub="{{ACTIVITY_ROLE.HELP}}">
          求助 <text class="seg-count">{{helpApprovals.length}}</text>
        </view>
      </view>
    </view>

    <scroll-view class="page-content" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullRefresh">
      <!-- 借入审批 — 我发布的需求借入（WANTED），别人主动借给我，由我确认借入 -->
      <view wx:if="{{approvalSubTab === ACTIVITY_ROLE.BORROW}}">
        <block wx:for="{{borrowApprovals}}" wx:key="id">
          <view class="progress-item" bindtap="onApprovalDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.BORROW}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name">愿意借出的住户：{{item.applicantName}}</view>
            </view>
            <view class="progress-act-btn return-btn" catchtap="onApprovalDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.BORROW}}">审批</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{borrowApprovals.length === 0}}">
          <text class="empty-text">暂无待确认的借入</text>
        </view>
      </view>

      <!-- 借出审批 — 我发布的闲置（LEND），别人申请借走，由我审批借出 -->
      <view wx:if="{{approvalSubTab === ACTIVITY_ROLE.LEND}}">
        <block wx:for="{{lendApprovals}}" wx:key="id">
          <view class="progress-item" bindtap="onApprovalDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.LEND}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name">希望借用的住户：{{item.applicantName}}</view>
            </view>
            <view class="progress-act-btn return-btn" catchtap="onApprovalDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.LEND}}">审批</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{lendApprovals.length === 0}}">
          <text class="empty-text">暂无待审批的借出申请</text>
        </view>
      </view>

      <!-- 帮助审批 -->
      <view wx:if="{{approvalSubTab === ACTIVITY_ROLE.HELP}}">
        <block wx:for="{{helpApprovals}}" wx:key="id">
          <view class="progress-item" bindtap="onApprovalDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.HELP}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name">主动帮忙的住户：{{item.applicantName}}</view>
            </view>
            <view class="progress-act-btn return-btn" catchtap="onApprovalDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.HELP}}">审批</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{helpApprovals.length === 0}}">
          <text class="empty-text">暂无待审批的帮助申请</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 进行中 ===== -->
  <view wx:if="{{mainTab === 'inProgress'}}" class="panel-wrap">
    <view class="seg-sub-wrap">
      <view class="segment">
        <view class="segment-item {{inProgressSubTab === ACTIVITY_ROLE.BORROW ? 'active' : ''}}" bindtap="onInProgressSubTap" data-sub="{{ACTIVITY_ROLE.BORROW}}">借入 <text class="seg-count">{{inProgressBorrows.length}}</text></view>
        <view class="segment-item {{inProgressSubTab === ACTIVITY_ROLE.LEND ? 'active' : ''}}" bindtap="onInProgressSubTap" data-sub="{{ACTIVITY_ROLE.LEND}}">借出 <text class="seg-count">{{inProgressLends.length}}</text></view>
        <view class="segment-item {{inProgressSubTab === ACTIVITY_ROLE.HELP_REQ ? 'active' : ''}}" bindtap="onInProgressSubTap" data-sub="{{ACTIVITY_ROLE.HELP_REQ}}">求助 <text class="seg-count">{{inProgressHelpReqs.length}}</text></view>
        <view class="segment-item {{inProgressSubTab === ACTIVITY_ROLE.HELP_PRO ? 'active' : ''}}" bindtap="onInProgressSubTap" data-sub="{{ACTIVITY_ROLE.HELP_PRO}}">帮助 <text class="seg-count">{{inProgressHelpPros.length}}</text></view>
      </view>
    </view>

    <scroll-view class="page-content" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullRefresh">
      <!-- 进行中 - 借入：已经借进来自己还未归还 -->
      <view wx:if="{{inProgressSubTab === ACTIVITY_ROLE.BORROW}}">
        <block wx:for="{{inProgressBorrows}}" wx:key="id">
          <view class="progress-item" bindtap="onReturnBorrow" data-id="{{item.id}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name">借出住户：{{item.personName}}</view>
              <view class="progress-meta">{{item.metaText}}</view>
            </view>
            <view class="progress-act-btn return-btn" catchtap="onReturnBorrow" data-id="{{item.id}}">归还</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{inProgressBorrows.length === 0}}">
          <text class="empty-text">暂无进行中的借入</text>
        </view>
      </view>

      <!-- 进行中 - 借出：已经借出去他人还未归还 -->
      <view wx:if="{{inProgressSubTab === ACTIVITY_ROLE.LEND}}">
        <block wx:for="{{inProgressLends}}" wx:key="id">
          <view class="progress-item" bindtap="onReturnLend" data-id="{{item.id}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name">借走住户：{{item.personName}}</view>
              <view class="progress-meta">{{item.metaText}}</view>
            </view>
            <view class="progress-act-btn return-btn" catchtap="onReturnLend" data-id="{{item.id}}">归还</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{inProgressLends.length === 0}}">
          <text class="empty-text">暂无进行中的借出</text>
        </view>
      </view>

      <!-- 进行中 - 求助：发起的求助已经在进行中还未结束 -->
      <view wx:if="{{inProgressSubTab === ACTIVITY_ROLE.HELP_REQ}}">
        <block wx:for="{{inProgressHelpReqs}}" wx:key="id">
          <view class="progress-item" bindtap="onEndHelpReq" data-id="{{item.id}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-meta">帮助住户：{{item.personName}}</view>
            </view>
            <view class="progress-act-btn end-btn" catchtap="onEndHelpReq" data-id="{{item.id}}">结束</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{inProgressHelpReqs.length === 0}}">
          <text class="empty-text">暂无进行中的求助</text>
        </view>
      </view>

      <!-- 进行中 - 帮助：主动帮助他人的还在进行中 -->
      <view wx:if="{{inProgressSubTab === ACTIVITY_ROLE.HELP_PRO}}">
        <block wx:for="{{inProgressHelpPros}}" wx:key="id">
          <view class="progress-item" bindtap="onEndHelpPro" data-id="{{item.id}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-meta">求助住户：{{item.personName}}</view>
            </view>
            <view class="progress-act-btn end-btn" catchtap="onEndHelpPro" data-id="{{item.id}}">结束</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{inProgressHelpPros.length === 0}}">
          <text class="empty-text">暂无进行中的帮助</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 已完成 ===== -->
  <view wx:if="{{mainTab === 'completed'}}" class="panel-wrap">
    <view class="seg-sub-wrap">
      <view class="segment">
        <view class="segment-item {{completedSubTab === ACTIVITY_ROLE.BORROW ? 'active' : ''}}" bindtap="onCompletedSubTap" data-sub="{{ACTIVITY_ROLE.BORROW}}">借入 <text class="seg-count">{{completedBorrows.length}}</text><text class="rate-dot" wx:if="{{pendingRating.borrow}}"></text></view>
        <view class="segment-item {{completedSubTab === ACTIVITY_ROLE.LEND ? 'active' : ''}}" bindtap="onCompletedSubTap" data-sub="{{ACTIVITY_ROLE.LEND}}">借出 <text class="seg-count">{{completedLends.length}}</text><text class="rate-dot" wx:if="{{pendingRating.lend}}"></text></view>
        <view class="segment-item {{completedSubTab === ACTIVITY_ROLE.HELP_REQ ? 'active' : ''}}" bindtap="onCompletedSubTap" data-sub="{{ACTIVITY_ROLE.HELP_REQ}}">求助 <text class="seg-count">{{completedHelpReqs.length}}</text><text class="rate-dot" wx:if="{{pendingRating.helpReq}}"></text></view>
        <view class="segment-item {{completedSubTab === ACTIVITY_ROLE.HELP_PRO ? 'active' : ''}}" bindtap="onCompletedSubTap" data-sub="{{ACTIVITY_ROLE.HELP_PRO}}">帮助 <text class="seg-count">{{completedHelpPros.length}}</text><text class="rate-dot" wx:if="{{pendingRating.helpPro}}"></text></view>
      </view>
    </view>

    <scroll-view class="page-content" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullRefresh">
      <!-- 已完成 - 借入 -->
      <view wx:if="{{completedSubTab === ACTIVITY_ROLE.BORROW}}">
        <block wx:for="{{completedBorrows}}" wx:key="id">
          <view class="progress-item" bindtap="onCompletedDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.BORROW}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name progress-name-secondary">借出住户：{{item.personName}}</view>
              <view class="progress-meta progress-meta-secondary">{{item.metaText}}</view>
            </view>
            <view class="progress-status {{item.statusTagClass}}">{{item.statusText}}</view>
            <view class="rating-pending-tag" wx:if="{{item.myRating === null}}">待评价</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{completedBorrows.length === 0}}">
          <text class="empty-text">暂无已完成的借入</text>
        </view>
      </view>

      <!-- 已完成 - 借出 -->
      <view wx:if="{{completedSubTab === ACTIVITY_ROLE.LEND}}">
        <block wx:for="{{completedLends}}" wx:key="id">
          <view class="progress-item" bindtap="onCompletedDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.LEND}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name progress-name-secondary">借走住户：{{item.personName}}</view>
              <view class="progress-meta progress-meta-secondary">{{item.metaText}}</view>
            </view>
            <view class="progress-status {{item.statusTagClass}}">{{item.statusText}}</view>
            <view class="rating-pending-tag" wx:if="{{item.myRating === null}}">待评价</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{completedLends.length === 0}}">
          <text class="empty-text">暂无已完成的借出</text>
        </view>
      </view>

      <!-- 已完成 - 求助 -->
      <view wx:if="{{completedSubTab === ACTIVITY_ROLE.HELP_REQ}}">
        <block wx:for="{{completedHelpReqs}}" wx:key="id">
          <view class="progress-item" bindtap="onCompletedDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.HELP_REQ}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name progress-name-secondary">帮忙用户：{{item.personName}}</view>
              <view class="progress-meta progress-meta-secondary">{{item.metaText}}</view>
            </view>
            <view class="progress-status {{item.statusTagClass}}">{{item.statusText}}</view>
            <view class="rating-pending-tag" wx:if="{{item.myRating === null}}">待评价</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{completedHelpReqs.length === 0}}">
          <text class="empty-text">暂无已完成的求助</text>
        </view>
      </view>

      <!-- 已完成 - 帮助 -->
      <view wx:if="{{completedSubTab === ACTIVITY_ROLE.HELP_PRO}}">
        <block wx:for="{{completedHelpPros}}" wx:key="id">
          <view class="progress-item" bindtap="onCompletedDetail" data-id="{{item.id}}" data-type="{{ACTIVITY_ROLE.HELP_PRO}}">
            <view class="progress-avatar">👤</view>
            <view class="progress-info">
              <view class="progress-title progress-title-lg">{{item.itemTitle}}</view>
              <view class="progress-name progress-name-secondary">求助住户：{{item.personName}}</view>
              <view class="progress-meta progress-meta-secondary">{{item.metaText}}</view>
            </view>
            <view class="progress-status {{item.statusTagClass}}">{{item.statusText}}</view>
            <view class="rating-pending-tag" wx:if="{{item.myRating === null}}">待评价</view>
          </view>
        </block>
        <view class="empty-state" wx:if="{{completedHelpPros.length === 0}}">
          <text class="empty-text">暂无已完成的帮助</text>
        </view>
      </view>
    </scroll-view>
  </view>

  </block>
</view>

<!-- ===== Drawer (slide-down from top) ===== -->
<view class="drawer-overlay" wx:if="{{showDrawer}}" catchtouchmove="preventTouchMove" bindtap="onCloseDrawer"></view>
<view class="drawer" wx:if="{{showDrawer}}">
  <view class="drawer-header">
    <text class="drawer-title">快捷入口</text>
    <view class="drawer-close" bindtap="onCloseDrawer">
      <text class="drawer-close-icon" style="font-size:28rpx;line-height:1;">✕</text>
    </view>
  </view>
  <view class="drawer-body">
    <view class="drawer-grid">
      <view class="drawer-entry" bindtap="onFeedBack">
        <view class="entry-icon">
          <image class="drawer-entry-img" src="../../images/icon-edit.svg" mode="aspectFit" />
        </view>
        <text class="entry-label">功能反馈</text>
      </view>
    </view>
  </view>
</view>

<!-- ===== Offline Confirm Alert ===== -->
<view class="alert-overlay" wx:if="{{showOfflineAlert}}" catchtap="onCloseOfflineAlert">
  <view class="alert" catchtap="">
    <view class="alert-title">确认下架</view>
    <view class="alert-body">下架后该内容将不再公开展示，确定继续？</view>
    <view class="alert-actions">
      <view class="alert-btn" bindtap="onCancelOffline">取消</view>
      <view class="alert-btn alert-btn-bold alert-btn-danger" bindtap="onDoOffline">确认下架</view>
    </view>
  </view>
</view>

<!-- ===== Edit Sheet (bottom sheet — flex column: fixed header + scroll body + fixed footer) ===== -->
<view class="edit-sheet-overlay" wx:if="{{showEditSheet}}" catchtouchmove="preventTouchMove" bindtap="onCloseEdit"></view>
<view class="edit-sheet" wx:if="{{showEditSheet}}">
  <view class="edit-sheet-header">
    <view class="edit-sheet-handle"></view>
    <view class="edit-sheet-title">编辑发布</view>
  </view>

  <scroll-view class="edit-sheet-body" scroll-y enhanced show-scrollbar="{{false}}">

    <!-- 发布类型（只读展示） -->
    <view class="input-group">
      <text class="edit-input-label">发布类型</text>
      <view class="segment" style="margin:0;">
        <view class="segment-item {{editPostType === POST_TYPE.LEND ? 'active' : ''}}">闲置借出</view>
        <view class="segment-item {{editPostType === POST_TYPE.WANTED ? 'active' : ''}}">需求借入</view>
